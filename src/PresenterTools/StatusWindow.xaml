<Window x:Class="PresenterTools.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Presenter Tools"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        SizeToContent="Height"
        Width="360"
        WindowStartupLocation="CenterScreen"
        Background="#FF2D3436"
        Foreground="White"
        Icon="Assets/PresenterTools.ico"
        MouseLeftButtonDown="OnDrag">
    <Window.Resources>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF444444" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <Grid>
            <Image Source="Assets/integrations-wordmark.png" Height="18" Margin="2,2,2,0"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Presenter Tools by integrations.at" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Chip}" Margin="0" Padding="6,2"
                        FontFamily="Segoe MDL2 Assets" FontSize="10" Content="&#xE921;"
                        ToolTip="Minimize" Click="OnMinimize" />
                <Button Style="{StaticResource Chip}" Margin="3,0,0,0" Padding="6,2"
                        FontFamily="Segoe MDL2 Assets" FontSize="10" Content="&#xE8BB;"
                        ToolTip="Close" Click="OnCloseWindow" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,10" TextTrimming="CharacterEllipsis" />

        <DockPanel>
            <Ellipse x:Name="StateDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="AccessText" Foreground="LightGray" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <TextBlock x:Name="ClientText" Foreground="LightGray" Margin="18,2,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="#FFFF7675" Margin="18,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <UniformGrid Rows="1" Margin="0,16,0,0">
            <Button x:Name="ToggleButton" Style="{StaticResource Chip}" Background="#FF0099FF" Click="OnToggle" />
            <Button Style="{StaticResource Chip}" Content="Settings" Click="OnSettings" />
            <Button Style="{StaticResource Chip}" Content="Log" Click="OnLog" />
        </UniformGrid>
    </StackPanel>
</Window>
