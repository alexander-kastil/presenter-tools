<Window x:Class="PresenterTools.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="#FF2D3436"
        Icon="Assets/PresenterTools.ico"
        MouseLeftButtonDown="OnDrag">
    <Window.Resources>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF444444" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="BorderBrush" Value="#FF777777" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="6" Width="164">
        <Grid Margin="0,0,0,8">
            <Image Source="Assets/integrations-wordmark.png" Height="18" Margin="2,2,2,0"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Presenter Tools by integrations.at" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CollapseButton" Style="{StaticResource Chip}" Margin="0,0,4,0"
                        Padding="6,2" FontFamily="Segoe MDL2 Assets" FontSize="10" Content="&#xE70E;"
                        ToolTip="Collapse" Click="OnToggleCollapse" />
                <Button Style="{StaticResource Chip}" Margin="0"
                        Padding="6,2" FontFamily="Segoe MDL2 Assets" FontSize="10" Content="&#xE8BB;"
                        ToolTip="Close" Click="OnClose" />
            </StackPanel>
        </Grid>
        <Button x:Name="TrayButton" Style="{StaticResource Chip}" Content="Minimize to tray" Visibility="Collapsed"
                ToolTip="Hide the toolbar; click the tray icon to bring it back" Click="OnMinimizeToTray" />
        <StackPanel x:Name="Body">
            <UniformGrid x:Name="Swatches" Columns="4" />
            <UniformGrid x:Name="PenSizes" Columns="4" Margin="0,4,0,4" />
            <Button x:Name="MouseButton" Style="{StaticResource Chip}" Content="Mouse" Click="OnMouse" />
            <Button x:Name="PenButton" Style="{StaticResource Chip}" Content="Pen" Click="OnPen" />
            <Button x:Name="TextButton" Style="{StaticResource Chip}" Content="Text" Click="OnText" />
            <Button x:Name="EraserButton" Style="{StaticResource Chip}" Content="Eraser" Click="OnEraser" />
            <Button x:Name="OptimizeButton" Style="{StaticResource Chip}" Content="Optimize" ToolTip="Clean up your last pen drawing" Click="OnOptimize" />
            <Button Style="{StaticResource Chip}" Content="Undo" Click="OnUndo" />
            <Button Style="{StaticResource Chip}" Content="Clear all" Click="OnClearAll" />
            <Border Height="1" Background="#FF555555" Margin="3,6" />
            <Button Style="{StaticResource Chip}" Content="Capture" ToolTip="Capture a screen region" Click="OnCapture" />
            <Button x:Name="LibraryButton" Style="{StaticResource Chip}" Content="Show Library" ToolTip="Open or close the screenshot library" Click="OnLibrary" />
            <Button x:Name="AirPlayButton" Style="{StaticResource Chip}" Content="AirPlay" ToolTip="Turn the AirPlay receiver on or off" Click="OnAirPlay" />
            <Button Style="{StaticResource Chip}" Content="Settings" Click="OnSettings" />
            <StackPanel x:Name="LibraryTools" Visibility="Collapsed">
                <Border Height="1" Background="#FF555555" Margin="3,6" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
